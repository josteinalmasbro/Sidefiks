{
  "name": "Artistens medlemsapp",
  "short_name": "Artistapp",
  "description": "Oppdater artistprofilen og ha all informasjon om neste bekreftede gig lett tilgjengelig.",
  "id": "/booking/?portal=member",
  "start_url": "/booking/?portal=member&tab=gig",
  "scope": "/booking/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#080c0f",
  "theme_color": "#0c1418",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/booking/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/booking/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Neste gig",
      "short_name": "Neste gig",
      "url": "/booking/?portal=member&tab=gig"
    },
    {
      "name": "Min profil",
      "short_name": "Profil",
      "url": "/booking/?portal=member&tab=profile"
    }
  ]
}
